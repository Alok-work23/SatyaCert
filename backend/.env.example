# Backend (FastAPI) — copy to backend/.env
ATLAS_DB_URL=mongodb+srv://<user>:<password>@<cluster>/
DB_NAME=academia_authenticator
# Ground-truth certificate records
COLLECTION_NAME=marksheets
# One document per verification attempt (user history + admin stats)
LOG_COLLECTION_NAME=verification_logs
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
MAX_PDF_MB=10
# Path to the Firebase service-account JSON (Firebase console → Project settings → Service accounts).
# Never commit this file.
FIREBASE_CREDENTIALS=./firebase-service-account.json
